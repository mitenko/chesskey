{
	"manifest_version": 2,
	"name": "ChessKey",
	"version": "2.1.2",
	"description": "Locks Lichess games until you reach your Puzzle Streak goal. Reaching the goal unlocks games for ten minutes, and every 5 more puzzles past it unlocks another ten.",
	"homepage_url": "https://github.com/mitenko/chesskey",
	"icons": {
		"48": "icons/icon48.png",
		"96": "icons/icon96.png"
	},
	"permissions": [
		"storage"
	],
    "options_ui": {
        "page": "dist/options.html",
        "open_in_tab": true
    },
	"content_scripts": [
        {
            "matches": [
                "https://lichess.org/",
				"https://lichess.org/#pool/*",
				"https://lichess.org/?any*",
				"https://lichess.org/tournament*",
                "https://lichess.org/streak*"
            ],
            "js": [
				"dist/bundle.js"
            ]
        }
	],
	"browser_specific_settings": {
		"gecko": {
			"id": "altersonic@yahoo.com"
		}
  	}
}
